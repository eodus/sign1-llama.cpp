#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#define MUL_MAT_ID 1
#include "mul_mat_vec_base.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE signed_sum16(const vec4 x0, const vec4 x1, const vec4 x2, const vec4 x3, const uint bits) {
    const bvec4 neg0 = notEqual(uvec4(bits) & uvec4(1u,2u,4u,8u), uvec4(0u));
    const bvec4 neg1 = notEqual(uvec4(bits) & uvec4(16u,32u,64u,128u), uvec4(0u));
    const bvec4 neg2 = notEqual(uvec4(bits) & uvec4(256u,512u,1024u,2048u), uvec4(0u));
    const bvec4 neg3 = notEqual(uvec4(bits) & uvec4(4096u,8192u,16384u,32768u), uvec4(0u));
    return FLOAT_TYPE(
        (dot(mix(x0, -x0, neg0), vec4(1.0)) + dot(mix(x1, -x1, neg1), vec4(1.0))) +
        (dot(mix(x2, -x2, neg2), vec4(1.0)) + dot(mix(x3, -x3, neg3), vec4(1.0))));
}

void main() {
    const uint lane = gl_SubgroupInvocationID;
    const uint first_row = gl_WorkGroupID.x * 4u;
    if (first_row >= p.stride_d) return;

    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    // K=1024: every lane owns sixteen adjacent activations and contributes
    // to four rows. The repacked uint64 stores one uint16 sign segment per row.
    const uint block_index = a_offset + (first_row >> 2u) * 64u + lane;
    const uvec2 signs = uvec2(data_a[block_index].qs[0], data_a[block_index].qs[1]);
    const uint activation_base = b_offset + lane * 16u;
    const vec4 x0 = vec4(data_b_v4[activation_base / 4u + 0u]);
    const vec4 x1 = vec4(data_b_v4[activation_base / 4u + 1u]);
    const vec4 x2 = vec4(data_b_v4[activation_base / 4u + 2u]);
    const vec4 x3 = vec4(data_b_v4[activation_base / 4u + 3u]);

    vec4 acc = vec4(
        signed_sum16(x0, x1, x2, x3, signs.x),
        signed_sum16(x0, x1, x2, x3, signs.x >> 16u),
        signed_sum16(x0, x1, x2, x3, signs.y),
        signed_sum16(x0, x1, x2, x3, signs.y >> 16u));

    acc = subgroupAdd(acc);
    if (lane == 0u) {
        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SCALE_ROWS_ID) != 0) {
            acc *= vec4(
                load_fuse0_f16(expert_id*p.stride_d + first_row + 0u),
                load_fuse0_f16(expert_id*p.stride_d + first_row + 1u),
                load_fuse0_f16(expert_id*p.stride_d + first_row + 2u),
                load_fuse0_f16(expert_id*p.stride_d + first_row + 3u));
        }
        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SCALE0) != 0) {
            acc *= FLOAT_TYPE(data_fuse0[gl_WorkGroupID.y]);
        }
        if ((p.fusion_flags & MAT_VEC_FUSION_FLAGS_SCALE1) != 0) {
            acc *= FLOAT_TYPE(data_fuse1[gl_WorkGroupID.y]);
        }
        data_d[d_offset + first_row + 0u] = D_TYPE(acc.x);
        data_d[d_offset + first_row + 1u] = D_TYPE(acc.y);
        data_d[d_offset + first_row + 2u] = D_TYPE(acc.z);
        data_d[d_offset + first_row + 3u] = D_TYPE(acc.w);
    }
}
