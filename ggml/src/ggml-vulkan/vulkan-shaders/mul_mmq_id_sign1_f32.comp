#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

#include "types.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(binding = 0) readonly buffer A32 { uint data_a[]; };
layout(binding = 1) readonly buffer B32 { uint data_b[]; };
layout(binding = 2) writeonly buffer D { D_TYPE data_d[]; };
layout(binding = 3) readonly buffer Rows { u16vec2 compact_rows[]; };
layout(binding = 4) readonly buffer Counts { int data_expert_count[]; };
layout(binding = 5) readonly buffer Scale { float16_t data_scale[]; };

layout(push_constant) uniform parameter {
    uint M;
    uint N;
    uint K;
    uint stride_a;
    uint stride_b;
    uint stride_d;
    uint batch_stride_a;
    uint batch_stride_b;
    uint batch_stride_d;
    uint nei0;
    uint nei1;
    uint nbi1;
    uint ne11;
    uint padded_N;
    uint fused_scale;
} p;

layout(constant_id = 0) const uint BLOCK_SIZE = 64;
layout(constant_id = 1) const uint BM = 32;
layout(constant_id = 2) const uint BN = 12;
layout(constant_id = 4) const uint WM = 32;
layout(constant_id = 5) const uint WN = 12;
layout(constant_id = 6) const uint WMITER = 1;
layout(constant_id = 7) const uint TM = 2;
layout(constant_id = 8) const uint TN = 1;
layout(constant_id = 9) const uint TK = 1;
layout(constant_id = 10) const uint WARP = 64;
layout(constant_id = 11) const uint K_SPEC = 0;
layout(constant_id = 12) const uint M_SPEC = 0;
layout(constant_id = 13) const uint EXPERT_MAJOR_B = 0;

#define BK 32u
#define MANTISSA_BITS 7u
#define HEADER_WORDS 2u
#define WORD_RECORD (1u + MANTISSA_BITS)

shared uint buf_a[BM];
shared uint buf_b[BN * WORD_RECORD];
shared u16vec2 row_ids[BN];
shared int positive_baseline[BN];
shared float vector_scale[BN];

uint cache_a[WMITER * TM];
uint expert_rows;
uint expert_offset;

uint kernel_k() {
    return K_SPEC != 0u ? K_SPEC : p.K;
}

uint kernel_m() {
    return M_SPEC != 0u ? M_SPEC : p.M;
}

uint vector_index(u16vec2 row) {
    return row.y * p.ne11 + (row.x % p.ne11);
}

uint packed_vector_index(u16vec2 row, uint compact_row) {
    return EXPERT_MAJOR_B != 0u ? expert_offset + compact_row : vector_index(row);
}

uint words_per_vector() {
    return HEADER_WORDS + WORD_RECORD * (kernel_k() / 32u);
}

uint row_segment(uint packed0, uint packed1, uint row_in_group) {
    if (row_in_group == 0u) return packed0 & 0xffffu;
    if (row_in_group == 1u) return packed0 >> 16u;
    if (row_in_group == 2u) return packed1 & 0xffffu;
    return packed1 >> 16u;
}

uint row_byte(uint packed0, uint packed1, uint row_in_group) {
    return row_in_group < 4u
        ? (packed0 >> (8u * row_in_group)) & 0xffu
        : (packed1 >> (8u * (row_in_group - 4u))) & 0xffu;
}

uint load_weight_word(uint expert, uint row, uint kword) {
    const uint channel_base = expert * (p.batch_stride_a / 32u);
    if (kernel_k() == 512u) {
        const uint row_group = row / 8u;
        const uint row_in_group = row % 8u;
        const uint group_base = channel_base + row_group * 128u;
        const uint lane = 4u * kword;
        uint word = 0u;
        [[unroll]] for (uint i = 0u; i < 4u; ++i) {
            const uint block = group_base + 2u * (lane + i);
            word |= row_byte(data_a[block], data_a[block + 1u], row_in_group) << (8u * i);
        }
        return word;
    }
    if (kernel_k() == 1024u) {
        const uint row_group = row / 4u;
        const uint row_in_group = row % 4u;
        const uint group_base = channel_base + row_group * 128u;
        const uint lane = 2u * kword;
        const uint block0 = group_base + 2u * lane;
        const uint block1 = block0 + 2u;
        const uint low = row_segment(data_a[block0], data_a[block0 + 1u], row_in_group);
        const uint high = row_segment(data_a[block1], data_a[block1 + 1u], row_in_group);
        return low | (high << 16u);
    }
    return data_a[channel_base + row * (p.stride_a / 32u) + kword];
}



ivec2 bitplane_dot2(uvec2 weight_bits, uint column) {
    const uint base = column * WORD_RECORD;
    const uint activation_sign = buf_b[base];
    const uvec2 effective_sign = weight_bits ^ uvec2(activation_sign);
    ivec2 correction = ivec2(0);
    [[unroll]] for (uint bit = 0u; bit < MANTISSA_BITS; ++bit) {
        const uint plane = buf_b[base + 1u + bit];
        correction.x += (2 * bitCount(plane & effective_sign.x)) << bit;
        correction.y += (2 * bitCount(plane & effective_sign.y)) << bit;
    }
    return correction;
}

void main() {
    const uint input_tile = gl_WorkGroupID.y;
    const uint expert = gl_WorkGroupID.z;
    const u16vec2 expert_header = compact_rows[expert * (p.nei1 + 1u)];
    expert_offset = expert_header.x;
    expert_rows = expert_header.y;
    if (input_tile * BN >= expert_rows) return;
    const uint active_columns = min(BN, expert_rows - input_tile * BN);

    const uint blocks_m = (kernel_m() + BM - 1u) / BM;
    const uint output_tile = gl_WorkGroupID.x % blocks_m;

    const uint wniter = (WM * WN) / (WARP * TM * TN * WMITER);
    const uint wsubm = WM / WMITER;
    const uint wsubn = WN / wniter;
    const uint warp = gl_LocalInvocationID.x / WARP;
    const uint lane = gl_LocalInvocationID.x % WARP;
    const uint lane_r = lane % (wsubm / TM);
    const uint lane_c = lane / (wsubm / TM);
    const uint warp_r = warp % (BM / WM);
    const uint warp_c = warp / (BM / WM);

    for (uint i = gl_LocalInvocationID.x; i < BN; i += BLOCK_SIZE) {
        const uint compact_row = input_tile * BN + i;
        if (compact_row < expert_rows) {
            const u16vec2 row = compact_rows[expert * (p.nei1 + 1u) + 1u + compact_row];
            row_ids[i] = row;
            const uint header = packed_vector_index(row, compact_row) * words_per_vector();
            vector_scale[i] = uintBitsToFloat(data_b[header]);
            positive_baseline[i] = int(data_b[header + 1u]);
        } else {
            row_ids[i] = u16vec2(0u);
            vector_scale[i] = 0.0;
            positive_baseline[i] = 0;
        }
    }
    barrier();

    int sums[WMITER * wniter * TN * TM];
    [[unroll]] for (uint ci = 0u; ci < wniter; ++ci) {
        [[unroll]] for (uint c = 0u; c < TN; ++c) {
            const uint column = warp_c * WN + ci * wsubn + lane_c * TN + c;
            const int baseline = column < BN ? positive_baseline[column] : 0;
            [[unroll]] for (uint ri = 0u; ri < WMITER; ++ri) {
                [[unroll]] for (uint r = 0u; r < TM; ++r) {
                    const uint idx = ((ci * TN + c) * WMITER + ri) * TM + r;
                    sums[idx] = baseline;
                }
            }
        }
    }

    for (uint k = 0u; k < kernel_k(); k += BK) {
        const uint lid = gl_LocalInvocationID.x;
        for (uint i = lid; i < BM; i += BLOCK_SIZE) {
            const uint row = output_tile * BM + i;
            buf_a[i] = row < kernel_m() ? load_weight_word(expert, row, k / BK) : 0u;
        }
        for (uint item = lid; item < BN * WORD_RECORD; item += BLOCK_SIZE) {
            const uint column = item / WORD_RECORD;
            const uint field = item % WORD_RECORD;
            const uint compact_row = input_tile * BN + column;
            if (compact_row < expert_rows) {
                const uint payload = packed_vector_index(row_ids[column], compact_row) * words_per_vector()
                                   + HEADER_WORDS + (k / 32u) * WORD_RECORD;
                buf_b[item] = data_b[payload + field];
            } else {
                buf_b[item] = 0u;
            }
        }
        barrier();

        [[unroll]] for (uint ri = 0u; ri < WMITER; ++ri) {
            [[unroll]] for (uint r = 0u; r < TM; ++r) {
                const uint reg = ri * TM + r;
                const uint src = warp_r * WM + ri * wsubm + lane_r * TM + r;
                cache_a[reg] = buf_a[src];
            }
        }

        [[unroll]] for (uint ci = 0u; ci < wniter; ++ci) {
            [[unroll]] for (uint c = 0u; c < TN; ++c) {
                const uint column = warp_c * WN + ci * wsubn + lane_c * TN + c;
                if (column < active_columns) {
                    [[unroll]] for (uint ri = 0u; ri < WMITER; ++ri) {
                        [[unroll]] for (uint r = 0u; r < TM; r += 2u) {
                            const uint reg = ri * TM + r;
                            const uint idx = ((ci * TN + c) * WMITER + ri) * TM + r;
                            const ivec2 correction = bitplane_dot2(
                                uvec2(cache_a[reg], cache_a[reg + 1u]), column);
                            sums[idx] -= correction.x;
                            sums[idx + 1u] -= correction.y;
                        }
                    }
                }
            }
        }
        barrier();
    }

    const uint base_r = output_tile * BM + warp_r * WM;
    const uint base_c = input_tile * BN + warp_c * WN;
    [[unroll]] for (uint ci = 0u; ci < wniter; ++ci) {
        [[unroll]] for (uint ri = 0u; ri < WMITER; ++ri) {
            const uint out_r0 = base_r + ri * wsubm + lane_r * TM;
            const uint out_c0 = base_c + ci * wsubn + lane_c * TN;
            [[unroll]] for (uint c = 0u; c < TN; ++c) {
                const uint compact_row = out_c0 + c;
                if (compact_row >= expert_rows) break;
                const uint column = compact_row - input_tile * BN;
                const u16vec2 row = row_ids[column];
                [[unroll]] for (uint r = 0u; r < TM; ++r) {
                    const uint out_r = out_r0 + r;
                    if (out_r < kernel_m()) {
                        const uint idx = ((ci * TN + c) * WMITER + ri) * TM + r;
                        float value = float(sums[idx]) * vector_scale[column];
                        if (p.fused_scale != 0u) value *= float(data_scale[expert * kernel_m() + out_r]);
                        data_d[row.y * p.batch_stride_d + row.x * p.stride_d + out_r] = D_TYPE(value);
                    }
                }
            }
        }
    }
}
